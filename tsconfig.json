{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": false,
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "noEmit": true,
    "paths": {
      "@imanect/yui": ["./packages/core/src/index.ts"],
      "@imanect/yui/svg": ["./packages/core/src/svg.ts"],
      "@imanect/yui/react": ["./packages/core/src/react/index.ts"]
    }
  },
  "include": ["packages/*/src", "packages/*/test", "eval/src", "eval/test", "scripts", "vitest.config.ts"]
}
