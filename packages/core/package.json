{
  "name": "@imanect/yui",
  "version": "0.9.1",
  "description": "Yui（結）: Markdown の ```ui ブロックに図を書くための、LLM が書きやすい小さな記法。パーサ・SVG レンダラー・React 部品",
  "keywords": [
    "markdown",
    "generative-ui",
    "llm",
    "chart",
    "flowchart",
    "diagram",
    "streaming",
    "parser",
    "svg",
    "react"
  ],
  "license": "MIT OR Apache-2.0",
  "author": "Imanect Labs",
  "homepage": "https://github.com/imanect-labs/y-ui#readme",
  "bugs": "https://github.com/imanect-labs/y-ui/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imanect-labs/y-ui.git",
    "directory": "packages/core"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./svg": {
      "types": "./dist/svg.d.ts",
      "import": "./dist/svg.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./editor": {
      "types": "./dist/editor/index.d.ts",
      "import": "./dist/editor/index.js"
    },
    "./editor/react": {
      "types": "./dist/editor/react/index.d.ts",
      "import": "./dist/editor/react/index.js"
    },
    "./export": {
      "types": "./dist/export.d.ts",
      "import": "./dist/export.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "cp ../../LICENSE-MIT ../../LICENSE-APACHE . && pnpm run build"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
