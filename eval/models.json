{
  "$comment": "評価に使うモデル。秘密情報は書かず、環境変数名だけを書く。effort ごとの追加パラメータは実機で要確認（docs/eval-plan.md）。api=gemini はネイティブの Gemini API、rpm は 1 分あたりのリクエスト数の上限。api=responses は Responses API（OpenCode Go の gpt-6-luna は Chat Completions を受け付けない）。headers は秘密情報を含まない追加ヘッダだけを書く。",
  "luna": {
    "baseUrlEnv": "OPENAI_BASE_URL",
    "baseUrlDefault": "https://api.openai.com/v1",
    "apiKeyEnv": "OPENAI_API_KEY",
    "modelEnv": "LUNA_MODEL",
    "model": "gpt-6-luna",
    "maxTokensParam": "max_completion_tokens",
    "maxTokens": 8192,
    "effort": {
      "low": {
        "reasoning_effort": "low"
      },
      "medium": {
        "reasoning_effort": "medium"
      },
      "high": {
        "reasoning_effort": "high"
      }
    }
  },
  "luna-go": {
    "api": "responses",
    "baseUrlEnv": "LUNA_GO_BASE_URL",
    "baseUrlDefault": "https://opencode.ai/inference/go/v1",
    "apiKeyEnv": "LUNA_GO_API_KEY",
    "modelEnv": "LUNA_MODEL",
    "model": "gpt-6-luna",
    "headers": {
      "user-agent": "yui-eval/1.0"
    },
    "sessionHeader": "x-opencode-session",
    "maxTokensParam": "max_completion_tokens",
    "maxTokens": 8192,
    "effort": {
      "low": {
        "reasoning": {
          "effort": "low"
        }
      },
      "medium": {
        "reasoning": {
          "effort": "medium"
        }
      },
      "high": {
        "reasoning": {
          "effort": "high"
        }
      }
    }
  },
  "gemma": {
    "baseUrlEnv": "GEMMA_BASE_URL",
    "apiKeyEnv": "GEMMA_API_KEY",
    "modelEnv": "GEMMA_MODEL",
    "model": "google/gemma-4-31B-it",
    "maxTokensParam": "max_tokens",
    "maxTokens": 8192,
    "effort": {
      "low": {
        "chat_template_kwargs": {
          "enable_thinking": false
        }
      },
      "medium": {
        "chat_template_kwargs": {
          "enable_thinking": true
        }
      },
      "high": {
        "chat_template_kwargs": {
          "enable_thinking": true
        }
      }
    }
  },
  "gemma-api": {
    "api": "gemini",
    "rpm": 15,
    "baseUrlEnv": "GEMINI_BASE_URL",
    "baseUrlDefault": "https://generativelanguage.googleapis.com/v1beta",
    "apiKeyEnv": "GEMINI_API_KEY",
    "modelEnv": "GEMMA_API_MODEL",
    "model": "gemma-4-31b-it",
    "maxTokensParam": "max_tokens",
    "maxTokens": 8192,
    "effort": {
      "default": {}
    }
  },
  "gemini-flash": {
    "api": "gemini",
    "rpm": 8,
    "baseUrlEnv": "GEMINI_BASE_URL",
    "baseUrlDefault": "https://generativelanguage.googleapis.com/v1beta",
    "apiKeyEnv": "GEMINI_API_KEY",
    "modelEnv": "GEMINI_FLASH_MODEL",
    "model": "gemini-flash-latest",
    "maxTokensParam": "max_tokens",
    "maxTokens": 8192,
    "effort": {
      "default": {},
      "low": {
        "generationConfig": {
          "thinkingConfig": {
            "thinkingLevel": "low"
          }
        }
      }
    }
  }
}
